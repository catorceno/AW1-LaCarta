# PostgreSQL: una sola base para Flask y Django
POSTGRES_USER=lacarta
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=lacarta

# Flask
FLASK_SECRET_KEY=cambia-esta-clave-larga
WEB_PORT=5001

# Django
DJANGO_SECRET_KEY=cambia-esta-otra-clave-larga
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Auth0: APIs > La Carta API, y Applications > La Carta SPA (Single Page Application).
# Flask solo verifica tokens: el client id de la SPA es público y no hay secreto.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=lacarta-api
AUTH0_SPA_CLIENT_ID=your-spa-client-id

DJANGO_AUTH0_CLIENT_ID=your-admin-app-client-id
DJANGO_AUTH0_CLIENT_SECRET=your-admin-app-client-secret
DJANGO_SECURE_COOKIES=0

# Producción (detrás de Nginx con HTTPS)
DJANGO_CSRF_TRUSTED_ORIGINS=
BEHIND_PROXY=0
GUNICORN_WORKERS=3