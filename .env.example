# PostgreSQL: una sola base para Flask y Django
POSTGRES_USER=lacarta
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=lacarta

# Flask
FLASK_SECRET_KEY=cambia-esta-clave-larga
WEB_PORT=5001

# Django
DJANGO_SECRET_KEY=cambia-esta-otra-clave-larga
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Auth0: Applications > La Carta Web, y APIs > La Carta API
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=lacarta-api
AUTH0_CLIENT_ID=your-web-app-client-id
# Secreto: nunca en el repo
AUTH0_CLIENT_SECRET=your-web-app-client-secret
SESSION_COOKIE_SECURE=0